{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Hello to Cheers - application/compute stack: ECS, ALB, networking, task definitions, services, IAM, logging. ECR repositories live in the separate infra/htc-ecr-repos.json foundation stack, deployed first. See docs/aws-cloudformation-ecs-deployment-plan.md, docs/aws-ecs-deployment-implementation.md, and docs/github-actions-deployment-implementation.md. Same template for sandbox and production, distinguished by EnvironmentName/parameter values, not by separate templates.",

  "Parameters": {
    "EnvironmentName": {
      "Type": "String",
      "Default": "sandbox",
      "AllowedValues": ["sandbox", "production"],
      "Description": "Used in resource naming/tags. Deploy to sandbox first and review before ever using production."
    },
    "VpcCidr": { "Type": "String", "Default": "10.20.0.0/16" },
    "PublicSubnet1Cidr": { "Type": "String", "Default": "10.20.0.0/24" },
    "PublicSubnet2Cidr": { "Type": "String", "Default": "10.20.1.0/24" },

    "VenueAppImage": {
      "Type": "String",
      "MinLength": 1,
      "Description": "Full ECR image URI:tag for the venue/product app. Build+push happens outside this template (see Dockerfile at repo root)."
    },
    "MarketingImage": {
      "Type": "String",
      "MinLength": 1,
      "Description": "Full ECR image URI:tag for marketing/. Build+push happens outside this template (see marketing/Dockerfile)."
    },
    "WorkspaceImage": {
      "Type": "String",
      "MinLength": 1,
      "Description": "Full ECR image URI:tag for workspace/. Build+push happens outside this template (see workspace/Dockerfile)."
    },

    "VenueAppHostname": {
      "Type": "String",
      "Default": "app.sandbox.hellotocheers.com",
      "MinLength": 1,
      "Description": "Used only for ALB host-header listener rules. No DNS record is created by this template (open decision - see docs). Before DNS exists, test with curl -H \"Host: <this value>\" against the ALB's own DNS name. MinLength enforced: an empty value here produces an empty ListenerRule condition, which CloudFormation rejects at resource-creation time with an opaque error rather than a clear parameter-validation failure."
    },
    "MarketingHostname": {
      "Type": "String",
      "Default": "sandbox.hellotocheers.com",
      "MinLength": 1
    },
    "WorkspaceHostname": {
      "Type": "String",
      "Default": "workspace.sandbox.hellotocheers.com",
      "MinLength": 1
    },

    "CertificateArn": {
      "Type": "String",
      "Default": "",
      "Description": "ACM certificate ARN for HTTPS. Leave blank for a first Sandbox smoke test over plain HTTP - the HTTPS listener is only created if this is set (see the HasCertificate Condition). Requesting/validating a real cert is a manual AWS step, not something this template can do. Deliberately no MinLength here - unlike every other parameter in this file, an empty value is this parameter's own correct, intentional default, not a missing-configuration bug."
    },

    "FromEmailAddress": {
      "Type": "String",
      "Default": "Hello to Cheers <jennifer@hellotocheers.com>",
      "MinLength": 1,
      "Description": "Non-secret. Venue app reads this as FROM_EMAIL; marketing/workspace read the same value as EMAIL_FROM (two variable names, confirmed in code - see docs/resend-production-setup-findings.md). hello@hellotocheers.com does not exist as a real mailbox; jennifer@hellotocheers.com is the confirmed real Sandbox address."
    },
    "EmailReplyTo": {
      "Type": "String",
      "Default": "jennifer@hellotocheers.com",
      "MinLength": 1,
      "Description": "Non-secret. Read only by marketing/workspace (EMAIL_REPLY_TO) - the venue app has no global Reply-To config, confirmed in code. Same real-mailbox correction as FromEmailAddress."
    },
    "SupabaseUrl": {
      "Type": "String",
      "MinLength": 1,
      "Description": "Non-secret (public Supabase project URL). Injected as both SUPABASE_URL and NEXT_PUBLIC_SUPABASE_URL at runtime - Next.js only inlines NEXT_PUBLIC_* into client bundles, not server-side code, so server Route Handlers and the proxy read it from process.env at runtime. No Default: a real Supabase project must exist and this must be supplied explicitly."
    },
    "SupabaseAnonKey": {
      "Type": "String",
      "MinLength": 1,
      "Description": "Public Supabase anon/publishable key. Browser-safe by design (Supabase RLS enforces access). Injected as both SUPABASE_ANON_KEY (plain runtime var, always read from process.env) and NEXT_PUBLIC_SUPABASE_ANON_KEY (for client bundle baking). No Default: must be supplied explicitly."
    },

    "ResendInboundAddress": {
      "Type": "String",
      "Default": "",
      "Description": "Venue app's Email Intake Engine domain suffix (RESEND_INBOUND_ADDRESS) - the per-venue forwarding address becomes leads+{key}@<the domain part of this value>. Deliberately no MinLength: an empty value is this parameter's own correct, intentional default until a real Resend Inbound domain + MX record exist (see docs/rc-launch-validation-runbook.md) - same pattern as CertificateArn above."
    },

    "StripePriceStarter": { "Type": "String", "Default": "", "Description": "Stripe Price ID (marketing/, STRIPE_PRICE_STARTER) for the Gather plan. Empty is a valid default until a real Price exists in the Stripe Dashboard - same pattern as CertificateArn." },
    "StripePriceStarterFounder": { "Type": "String", "Default": "", "Description": "Stripe Price ID (STRIPE_PRICE_STARTER_FOUNDER), Gather founder variant. Empty is a valid default." },
    "StripePriceGrowing": { "Type": "String", "Default": "", "Description": "Stripe Price ID (STRIPE_PRICE_GROWING) for the Celebrate plan. Empty is a valid default until a real Price exists in the Stripe Dashboard." },
    "StripePriceGrowingFounder": { "Type": "String", "Default": "", "Description": "Stripe Price ID (STRIPE_PRICE_GROWING_FOUNDER), Celebrate founder variant. Empty is a valid default." },
    "StripePriceProfessional": { "Type": "String", "Default": "", "Description": "Stripe Price ID (STRIPE_PRICE_PROFESSIONAL) for the Flourish plan. Empty is a valid default until a real Price exists in the Stripe Dashboard." },
    "StripePriceProfessionalFounder": { "Type": "String", "Default": "", "Description": "Stripe Price ID (STRIPE_PRICE_PROFESSIONAL_FOUNDER), Flourish founder variant. Empty is a valid default." },
    "StripePriceWhiteGlove": { "Type": "String", "Default": "", "Description": "Stripe Price ID (STRIPE_PRICE_WHITE_GLOVE), one-time White Glove onboarding add-on. Empty is a valid default." },
    "StripeFoundingCouponId": { "Type": "String", "Default": "", "Description": "Stripe Coupon ID (STRIPE_FOUNDING_COUPON_ID), applies to Gather only. Empty is a valid default." },
    "CronSecret": {
      "Type": "String",
      "NoEcho": true,
      "Default": "",
      "Description": "Bearer token for venue-app cron routes (CRON_SECRET). EventBridge sends Authorization: Bearer <this>. Leave empty to skip creating the Facebook Lead Ads schedules; webhook after() still processes leads immediately. Populate in the stack parameter (NoEcho) — do not commit the value."
    }
  },

  "Conditions": {
    "HasCertificate": { "Fn::Not": [{ "Fn::Equals": [{ "Ref": "CertificateArn" }, ""] }] },
    "IsProduction": { "Fn::Equals": [{ "Ref": "EnvironmentName" }, "production"] },
    "HasCronSecret": { "Fn::Not": [{ "Fn::Equals": [{ "Ref": "CronSecret" }, ""] }] }
  },

  "Resources": {

    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": { "Ref": "VpcCidr" },
        "EnableDnsHostnames": true,
        "EnableDnsSupport": true,
        "Tags": [{ "Key": "Name", "Value": { "Fn::Sub": "htc-${EnvironmentName}-vpc" } }]
      }
    },
    "InternetGateway": { "Type": "AWS::EC2::InternetGateway" },
    "VpcGatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": { "VpcId": { "Ref": "Vpc" }, "InternetGatewayId": { "Ref": "InternetGateway" } }
    },

    "PublicSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": { "Ref": "Vpc" },
        "CidrBlock": { "Ref": "PublicSubnet1Cidr" },
        "AvailabilityZone": { "Fn::Select": [0, { "Fn::GetAZs": "" }] },
        "MapPublicIpOnLaunch": true,
        "Tags": [{ "Key": "Name", "Value": { "Fn::Sub": "htc-${EnvironmentName}-public-1" } }]
      }
    },
    "PublicSubnet2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": { "Ref": "Vpc" },
        "CidrBlock": { "Ref": "PublicSubnet2Cidr" },
        "AvailabilityZone": { "Fn::Select": [1, { "Fn::GetAZs": "" }] },
        "MapPublicIpOnLaunch": true,
        "Tags": [{ "Key": "Name", "Value": { "Fn::Sub": "htc-${EnvironmentName}-public-2" } }]
      }
    },
    "PublicRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": { "VpcId": { "Ref": "Vpc" } }
    },
    "PublicRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "VpcGatewayAttachment",
      "Properties": {
        "RouteTableId": { "Ref": "PublicRouteTable" },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": { "Ref": "InternetGateway" }
      }
    },
    "PublicSubnet1RouteAssoc": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": { "SubnetId": { "Ref": "PublicSubnet1" }, "RouteTableId": { "Ref": "PublicRouteTable" } }
    },
    "PublicSubnet2RouteAssoc": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": { "SubnetId": { "Ref": "PublicSubnet2" }, "RouteTableId": { "Ref": "PublicRouteTable" } }
    },

    "AlbSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "ALB - public HTTP/HTTPS",
        "VpcId": { "Ref": "Vpc" },
        "SecurityGroupIngress": [
          { "IpProtocol": "tcp", "FromPort": 80, "ToPort": 80, "CidrIp": "0.0.0.0/0" },
          { "IpProtocol": "tcp", "FromPort": 443, "ToPort": 443, "CidrIp": "0.0.0.0/0" }
        ],
        "SecurityGroupEgress": [{ "IpProtocol": "-1", "CidrIp": "0.0.0.0/0" }]
      }
    },
    "EcsTaskSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "ECS tasks - inbound only from the ALB, on the container port; outbound HTTPS to Supabase/Resend/Stripe and cross-app calls",
        "VpcId": { "Ref": "Vpc" },
        "SecurityGroupIngress": [
          { "IpProtocol": "tcp", "FromPort": 3000, "ToPort": 3000, "SourceSecurityGroupId": { "Ref": "AlbSecurityGroup" } }
        ],
        "SecurityGroupEgress": [{ "IpProtocol": "-1", "CidrIp": "0.0.0.0/0" }]
      }
    },

    "EcsCluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": { "Fn::Sub": "htc-${EnvironmentName}" },
        "ClusterSettings": [{ "Name": "containerInsights", "Value": "enabled" }]
      }
    },

    "VenueAppLogGroup": { "Type": "AWS::Logs::LogGroup", "Properties": { "LogGroupName": { "Fn::Sub": "/ecs/htc-${EnvironmentName}/venue-app" }, "RetentionInDays": 30 } },
    "MarketingLogGroup": { "Type": "AWS::Logs::LogGroup", "Properties": { "LogGroupName": { "Fn::Sub": "/ecs/htc-${EnvironmentName}/marketing" }, "RetentionInDays": 30 } },
    "WorkspaceLogGroup": { "Type": "AWS::Logs::LogGroup", "Properties": { "LogGroupName": { "Fn::Sub": "/ecs/htc-${EnvironmentName}/workspace" }, "RetentionInDays": 30 } },

    "EcsTaskExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": { "Fn::Sub": "htc-${EnvironmentName}-ecs-task-execution" },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{ "Effect": "Allow", "Principal": { "Service": "ecs-tasks.amazonaws.com" }, "Action": "sts:AssumeRole" }]
        },
        "ManagedPolicyArns": ["arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"],
        "Policies": [{
          "PolicyName": "ReadHtcSecrets",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [{
              "Effect": "Allow",
              "Action": ["secretsmanager:GetSecretValue"],
              "Resource": [
                { "Ref": "SupabaseServiceRoleKeySecret" },
                { "Ref": "ResendApiKeySecret" },
                { "Ref": "ProductSyncApiKeySecret" },
                { "Ref": "StripeConnectSecrets" },
                { "Ref": "StripeSaasSecrets" },
                { "Ref": "QuickBooksSecrets" },
                { "Ref": "FacebookSecrets" },
                { "Ref": "AnthropicApiKeySecret" },
                { "Ref": "ResendWebhookSecretSecret" }
              ]
            }]
          }
        }]
      }
    },
    "EcsTaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": { "Fn::Sub": "htc-${EnvironmentName}-ecs-task" },
        "Description": "Intentionally near-empty: zero AWS SDK calls exist anywhere in the app code (all storage/database access is Supabase-over-HTTPS). This role exists because ECS requires a task role, not because the app needs AWS API access.",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{ "Effect": "Allow", "Principal": { "Service": "ecs-tasks.amazonaws.com" }, "Action": "sts:AssumeRole" }]
        }
      }
    },

    "SupabaseServiceRoleKeySecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": { "Fn::Sub": "htc/${EnvironmentName}/supabase-service-role-key" },
        "Description": "Placeholder value only (CHANGE_ME) - CloudFormation cannot create a Secrets Manager secret with no value. Populate the real value with aws secretsmanager put-secret-value (or the Console) immediately after stack creation, never in this template.",
        "SecretString": "{\"value\":\"CHANGE_ME\"}"
      }
    },
    "ResendApiKeySecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": { "Fn::Sub": "htc/${EnvironmentName}/resend-api-key" },
        "SecretString": "{\"value\":\"CHANGE_ME\"}"
      }
    },
    "ProductSyncApiKeySecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": { "Fn::Sub": "htc/${EnvironmentName}/product-sync-api-key" },
        "Description": "Placeholder value only (CHANGE_ME). Must end up byte-identical across all three apps once populated - it's one secret, referenced by all three task definitions below, not three separate values.",
        "SecretString": "{\"value\":\"CHANGE_ME\"}"
      }
    },
    "AnthropicApiKeySecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": { "Fn::Sub": "htc/${EnvironmentName}/anthropic-api-key" },
        "Description": "Placeholder value only (CHANGE_ME). Powers the Email Intake Engine's inquiry extraction (lib/lead-intake/email-extract.ts) - a real Anthropic API key from console.anthropic.com.",
        "SecretString": "{\"value\":\"CHANGE_ME\"}"
      }
    },
    "ResendWebhookSecretSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": { "Fn::Sub": "htc/${EnvironmentName}/resend-webhook-secret" },
        "Description": "Placeholder is an EMPTY string, not CHANGE_ME, deliberately - both app/api/leads/email-intake/route.ts and app/api/messaging/inbound/route.ts treat an unset RESEND_WEBHOOK_SECRET as 'skip signature verification, stay open' and a set one as 'enforce Svix verification'; a non-empty placeholder would flip on enforcement with a value that can never verify anything, silently breaking both endpoints. Populate with the real Signing Secret from Resend Dashboard -> Webhooks once the endpoint is configured there - both routes now implement Svix verification identically (shared via lib/resend/inbound-webhook.ts), so this is safe to populate for both at once.",
        "SecretString": "{\"value\":\"\"}"
      }
    },
    "StripeSaasSecrets": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": { "Fn::Sub": "htc/${EnvironmentName}/stripe-saas" },
        "Description": "marketing/'s Stripe SaaS billing keys - STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET, separate from Connect below",
        "SecretString": "{\"STRIPE_SECRET_KEY\":\"CHANGE_ME\",\"STRIPE_WEBHOOK_SECRET\":\"CHANGE_ME\"}"
      }
    },
    "StripeConnectSecrets": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": { "Fn::Sub": "htc/${EnvironmentName}/stripe-connect" },
        "Description": "Venue app's existing Stripe Connect keys - not part of the first E2E path, included for completeness",
        "SecretString": "{\"STRIPE_SECRET_KEY\":\"CHANGE_ME\",\"STRIPE_WEBHOOK_SECRET\":\"CHANGE_ME\"}"
      }
    },
    "QuickBooksSecrets": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": { "Fn::Sub": "htc/${EnvironmentName}/quickbooks" },
        "Description": "Venue app's QuickBooks Online OAuth app keys - QUICKBOOKS_CLIENT_ID + QUICKBOOKS_CLIENT_SECRET, from a real Intuit Developer Portal app. Placeholder value only (CHANGE_ME) - populate with aws secretsmanager put-secret-value after the Intuit app exists, never in this template.",
        "SecretString": "{\"QUICKBOOKS_CLIENT_ID\":\"CHANGE_ME\",\"QUICKBOOKS_CLIENT_SECRET\":\"CHANGE_ME\"}"
      }
    },
    "FacebookSecrets": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": { "Fn::Sub": "htc/${EnvironmentName}/facebook" },
        "Description": "Venue app Meta Lead Ads keys. FACEBOOK_APP_ID is the same app id as NEXT_PUBLIC_FACEBOOK_APP_ID (not a secret, stored here so the OAuth callback can read FACEBOOK_APP_ID at runtime). FACEBOOK_APP_SECRET signs webhooks and exchanges tokens. FACEBOOK_WEBHOOK_VERIFY_TOKEN is the hub.verify_token string configured on the Meta app webhook. FACEBOOK_SYNC_SECRET gates manual POST /api/facebook/sync/process. Empty strings are intentional until the Meta app is configured — do not put real values in this template.",
        "SecretString": "{\"FACEBOOK_APP_ID\":\"\",\"FACEBOOK_APP_SECRET\":\"\",\"FACEBOOK_WEBHOOK_VERIFY_TOKEN\":\"\",\"FACEBOOK_SYNC_SECRET\":\"\"}"
      }
    },

    "VenueAppTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": { "Fn::Sub": "htc-${EnvironmentName}-venue-app" },
        "RequiresCompatibilities": ["FARGATE"],
        "NetworkMode": "awsvpc",
        "Cpu": "512",
        "Memory": "1024",
        "ExecutionRoleArn": { "Fn::GetAtt": ["EcsTaskExecutionRole", "Arn"] },
        "TaskRoleArn": { "Fn::GetAtt": ["EcsTaskRole", "Arn"] },
        "ContainerDefinitions": [{
          "Name": "venue-app",
          "Image": { "Ref": "VenueAppImage" },
          "PortMappings": [{ "ContainerPort": 3000, "Protocol": "tcp" }],
          "Environment": [
            { "Name": "NODE_ENV", "Value": "production" },
            { "Name": "SUPABASE_URL", "Value": { "Ref": "SupabaseUrl" } },
            { "Name": "NEXT_PUBLIC_SUPABASE_URL", "Value": { "Ref": "SupabaseUrl" } },
            { "Name": "SUPABASE_ANON_KEY", "Value": { "Ref": "SupabaseAnonKey" } },
            { "Name": "NEXT_PUBLIC_SUPABASE_ANON_KEY", "Value": { "Ref": "SupabaseAnonKey" } },
            { "Name": "FROM_EMAIL", "Value": { "Ref": "FromEmailAddress" } },
            { "Name": "RESEND_INBOUND_ADDRESS", "Value": { "Ref": "ResendInboundAddress" } },
            { "Name": "QUICKBOOKS_ENVIRONMENT", "Value": { "Fn::If": ["IsProduction", "production", "sandbox"] } },
            { "Name": "CRON_SECRET", "Value": { "Ref": "CronSecret" } },
            { "Name": "NEXT_PUBLIC_APP_URL", "Value": { "Fn::Sub": "https://${VenueAppHostname}" } }
          ],
          "Secrets": [
            { "Name": "SUPABASE_SERVICE_ROLE_KEY", "ValueFrom": { "Fn::Sub": "${SupabaseServiceRoleKeySecret}:value::" } },
            { "Name": "RESEND_API_KEY", "ValueFrom": { "Fn::Sub": "${ResendApiKeySecret}:value::" } },
            { "Name": "PRODUCT_SYNC_API_KEY", "ValueFrom": { "Fn::Sub": "${ProductSyncApiKeySecret}:value::" } },
            { "Name": "STRIPE_SECRET_KEY", "ValueFrom": { "Fn::Sub": "${StripeConnectSecrets}:STRIPE_SECRET_KEY::" } },
            { "Name": "STRIPE_WEBHOOK_SECRET", "ValueFrom": { "Fn::Sub": "${StripeConnectSecrets}:STRIPE_WEBHOOK_SECRET::" } },
            { "Name": "QUICKBOOKS_CLIENT_ID", "ValueFrom": { "Fn::Sub": "${QuickBooksSecrets}:QUICKBOOKS_CLIENT_ID::" } },
            { "Name": "QUICKBOOKS_CLIENT_SECRET", "ValueFrom": { "Fn::Sub": "${QuickBooksSecrets}:QUICKBOOKS_CLIENT_SECRET::" } },
            { "Name": "FACEBOOK_APP_ID", "ValueFrom": { "Fn::Sub": "${FacebookSecrets}:FACEBOOK_APP_ID::" } },
            { "Name": "FACEBOOK_APP_SECRET", "ValueFrom": { "Fn::Sub": "${FacebookSecrets}:FACEBOOK_APP_SECRET::" } },
            { "Name": "FACEBOOK_WEBHOOK_VERIFY_TOKEN", "ValueFrom": { "Fn::Sub": "${FacebookSecrets}:FACEBOOK_WEBHOOK_VERIFY_TOKEN::" } },
            { "Name": "FACEBOOK_SYNC_SECRET", "ValueFrom": { "Fn::Sub": "${FacebookSecrets}:FACEBOOK_SYNC_SECRET::" } },
            { "Name": "ANTHROPIC_API_KEY", "ValueFrom": { "Fn::Sub": "${AnthropicApiKeySecret}:value::" } },
            { "Name": "RESEND_WEBHOOK_SECRET", "ValueFrom": { "Fn::Sub": "${ResendWebhookSecretSecret}:value::" } }
          ],
          "LogConfiguration": {
            "LogDriver": "awslogs",
            "Options": {
              "awslogs-group": { "Ref": "VenueAppLogGroup" },
              "awslogs-region": { "Ref": "AWS::Region" },
              "awslogs-stream-prefix": "venue-app"
            }
          }
        }]
      }
    },
    "MarketingTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": { "Fn::Sub": "htc-${EnvironmentName}-marketing" },
        "RequiresCompatibilities": ["FARGATE"],
        "NetworkMode": "awsvpc",
        "Cpu": "256",
        "Memory": "512",
        "ExecutionRoleArn": { "Fn::GetAtt": ["EcsTaskExecutionRole", "Arn"] },
        "TaskRoleArn": { "Fn::GetAtt": ["EcsTaskRole", "Arn"] },
        "ContainerDefinitions": [{
          "Name": "marketing",
          "Image": { "Ref": "MarketingImage" },
          "PortMappings": [{ "ContainerPort": 3000, "Protocol": "tcp" }],
          "Environment": [
            { "Name": "NODE_ENV", "Value": "production" },
            { "Name": "EMAIL_FROM", "Value": { "Ref": "FromEmailAddress" } },
            { "Name": "EMAIL_REPLY_TO", "Value": { "Ref": "EmailReplyTo" } },
            { "Name": "PRODUCT_API_BASE_URL", "Value": { "Fn::Sub": "https://${VenueAppHostname}" } },
            { "Name": "WORKSPACE_URL", "Value": { "Fn::Sub": "https://${WorkspaceHostname}" } },
            { "Name": "STRIPE_GATHER_PRICE_ID", "Value": { "Ref": "StripePriceStarter" } },
            { "Name": "STRIPE_PRICE_STARTER", "Value": { "Ref": "StripePriceStarter" } },
            { "Name": "STRIPE_PRICE_STARTER_FOUNDER", "Value": { "Ref": "StripePriceStarterFounder" } },
            { "Name": "FOUNDER_PROGRAM_ACTIVE", "Value": "true" },
            { "Name": "FOUNDER_SPOTS_REMAINING", "Value": "100" },
            { "Name": "STRIPE_PRICE_GROWING", "Value": { "Ref": "StripePriceGrowing" } },
            { "Name": "STRIPE_PRICE_GROWING_FOUNDER", "Value": { "Ref": "StripePriceGrowingFounder" } },
            { "Name": "STRIPE_PRICE_PROFESSIONAL", "Value": { "Ref": "StripePriceProfessional" } },
            { "Name": "STRIPE_PRICE_PROFESSIONAL_FOUNDER", "Value": { "Ref": "StripePriceProfessionalFounder" } },
            { "Name": "STRIPE_PRICE_WHITE_GLOVE", "Value": { "Ref": "StripePriceWhiteGlove" } },
            { "Name": "STRIPE_FOUNDING_COUPON_ID", "Value": { "Ref": "StripeFoundingCouponId" } }
          ],
          "Secrets": [
            { "Name": "RESEND_API_KEY", "ValueFrom": { "Fn::Sub": "${ResendApiKeySecret}:value::" } },
            { "Name": "PRODUCT_SYNC_API_KEY", "ValueFrom": { "Fn::Sub": "${ProductSyncApiKeySecret}:value::" } },
            { "Name": "STRIPE_SECRET_KEY", "ValueFrom": { "Fn::Sub": "${StripeSaasSecrets}:STRIPE_SECRET_KEY::" } },
            { "Name": "STRIPE_WEBHOOK_SECRET", "ValueFrom": { "Fn::Sub": "${StripeSaasSecrets}:STRIPE_WEBHOOK_SECRET::" } }
          ],
          "LogConfiguration": {
            "LogDriver": "awslogs",
            "Options": {
              "awslogs-group": { "Ref": "MarketingLogGroup" },
              "awslogs-region": { "Ref": "AWS::Region" },
              "awslogs-stream-prefix": "marketing"
            }
          }
        }]
      }
    },
    "WorkspaceTaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": { "Fn::Sub": "htc-${EnvironmentName}-workspace" },
        "RequiresCompatibilities": ["FARGATE"],
        "NetworkMode": "awsvpc",
        "Cpu": "256",
        "Memory": "512",
        "ExecutionRoleArn": { "Fn::GetAtt": ["EcsTaskExecutionRole", "Arn"] },
        "TaskRoleArn": { "Fn::GetAtt": ["EcsTaskRole", "Arn"] },
        "ContainerDefinitions": [{
          "Name": "workspace",
          "Image": { "Ref": "WorkspaceImage" },
          "PortMappings": [{ "ContainerPort": 3000, "Protocol": "tcp" }],
          "Environment": [
            { "Name": "NODE_ENV", "Value": "production" },
            { "Name": "EMAIL_FROM", "Value": { "Ref": "FromEmailAddress" } },
            { "Name": "PRODUCT_API_BASE_URL", "Value": { "Fn::Sub": "https://${VenueAppHostname}" } }
          ],
          "Secrets": [
            { "Name": "RESEND_API_KEY", "ValueFrom": { "Fn::Sub": "${ResendApiKeySecret}:value::" } },
            { "Name": "PRODUCT_SYNC_API_KEY", "ValueFrom": { "Fn::Sub": "${ProductSyncApiKeySecret}:value::" } }
          ],
          "LogConfiguration": {
            "LogDriver": "awslogs",
            "Options": {
              "awslogs-group": { "Ref": "WorkspaceLogGroup" },
              "awslogs-region": { "Ref": "AWS::Region" },
              "awslogs-stream-prefix": "workspace"
            }
          }
        }]
      }
    },

    "Alb": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Name": { "Fn::Sub": "htc-${EnvironmentName}-alb" },
        "Scheme": "internet-facing",
        "Type": "application",
        "Subnets": [{ "Ref": "PublicSubnet1" }, { "Ref": "PublicSubnet2" }],
        "SecurityGroups": [{ "Ref": "AlbSecurityGroup" }]
      }
    },

    "VenueAppTargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Name": { "Fn::Sub": "htc-${EnvironmentName}-venue-app" },
        "Port": 3000, "Protocol": "HTTP", "TargetType": "ip", "VpcId": { "Ref": "Vpc" },
        "HealthCheckPath": "/login",
        "HealthCheckIntervalSeconds": 30,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 3,
        "Matcher": { "HttpCode": "200" }
      }
    },
    "MarketingTargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Name": { "Fn::Sub": "htc-${EnvironmentName}-marketing" },
        "Port": 3000, "Protocol": "HTTP", "TargetType": "ip", "VpcId": { "Ref": "Vpc" },
        "HealthCheckPath": "/",
        "HealthCheckIntervalSeconds": 30,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 3,
        "Matcher": { "HttpCode": "200" }
      }
    },
    "WorkspaceTargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Name": { "Fn::Sub": "htc-${EnvironmentName}-workspace" },
        "Port": 3000, "Protocol": "HTTP", "TargetType": "ip", "VpcId": { "Ref": "Vpc" },
        "HealthCheckPath": "/",
        "HealthCheckIntervalSeconds": 30,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 3,
        "Matcher": { "HttpCode": "200-399" }
      }
    },

    "HttpListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": { "Ref": "Alb" },
        "Port": 80, "Protocol": "HTTP",
        "DefaultActions": [{ "Type": "forward", "TargetGroupArn": { "Ref": "MarketingTargetGroup" } }]
      }
    },
    "HttpsListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Condition": "HasCertificate",
      "Properties": {
        "LoadBalancerArn": { "Ref": "Alb" },
        "Port": 443, "Protocol": "HTTPS",
        "Certificates": [{ "CertificateArn": { "Ref": "CertificateArn" } }],
        "DefaultActions": [{ "Type": "forward", "TargetGroupArn": { "Ref": "MarketingTargetGroup" } }]
      }
    },

    "VenueAppHttpRule": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": { "Ref": "HttpListener" },
        "Priority": 10,
        "Conditions": [{ "Field": "host-header", "Values": [{ "Ref": "VenueAppHostname" }] }],
        "Actions": [{ "Type": "forward", "TargetGroupArn": { "Ref": "VenueAppTargetGroup" } }]
      }
    },
    "WorkspaceHttpRule": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": { "Ref": "HttpListener" },
        "Priority": 20,
        "Conditions": [{ "Field": "host-header", "Values": [{ "Ref": "WorkspaceHostname" }] }],
        "Actions": [{ "Type": "forward", "TargetGroupArn": { "Ref": "WorkspaceTargetGroup" } }]
      }
    },

    "VenueAppHttpsRule": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Condition": "HasCertificate",
      "Properties": {
        "ListenerArn": { "Ref": "HttpsListener" },
        "Priority": 10,
        "Conditions": [{ "Field": "host-header", "Values": [{ "Ref": "VenueAppHostname" }] }],
        "Actions": [{ "Type": "forward", "TargetGroupArn": { "Ref": "VenueAppTargetGroup" } }]
      }
    },
    "WorkspaceHttpsRule": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Condition": "HasCertificate",
      "Properties": {
        "ListenerArn": { "Ref": "HttpsListener" },
        "Priority": 20,
        "Conditions": [{ "Field": "host-header", "Values": [{ "Ref": "WorkspaceHostname" }] }],
        "Actions": [{ "Type": "forward", "TargetGroupArn": { "Ref": "WorkspaceTargetGroup" } }]
      }
    },

    "VenueAppService": {
      "Type": "AWS::ECS::Service",
      "DependsOn": ["VenueAppHttpRule"],
      "Properties": {
        "ServiceName": { "Fn::Sub": "htc-${EnvironmentName}-venue-app" },
        "Cluster": { "Ref": "EcsCluster" },
        "TaskDefinition": { "Ref": "VenueAppTaskDefinition" },
        "DesiredCount": 1,
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": [{ "Ref": "PublicSubnet1" }, { "Ref": "PublicSubnet2" }],
            "SecurityGroups": [{ "Ref": "EcsTaskSecurityGroup" }]
          }
        },
        "LoadBalancers": [{ "ContainerName": "venue-app", "ContainerPort": 3000, "TargetGroupArn": { "Ref": "VenueAppTargetGroup" } }],
        "HealthCheckGracePeriodSeconds": 120
      }
    },
    "MarketingService": {
      "Type": "AWS::ECS::Service",
      "DependsOn": ["HttpListener"],
      "Properties": {
        "ServiceName": { "Fn::Sub": "htc-${EnvironmentName}-marketing" },
        "Cluster": { "Ref": "EcsCluster" },
        "TaskDefinition": { "Ref": "MarketingTaskDefinition" },
        "DesiredCount": 1,
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": [{ "Ref": "PublicSubnet1" }, { "Ref": "PublicSubnet2" }],
            "SecurityGroups": [{ "Ref": "EcsTaskSecurityGroup" }]
          }
        },
        "LoadBalancers": [{ "ContainerName": "marketing", "ContainerPort": 3000, "TargetGroupArn": { "Ref": "MarketingTargetGroup" } }],
        "HealthCheckGracePeriodSeconds": 120
      }
    },
    "WorkspaceService": {
      "Type": "AWS::ECS::Service",
      "DependsOn": ["WorkspaceHttpRule"],
      "Properties": {
        "ServiceName": { "Fn::Sub": "htc-${EnvironmentName}-workspace" },
        "Cluster": { "Ref": "EcsCluster" },
        "TaskDefinition": { "Ref": "WorkspaceTaskDefinition" },
        "DesiredCount": 1,
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": [{ "Ref": "PublicSubnet1" }, { "Ref": "PublicSubnet2" }],
            "SecurityGroups": [{ "Ref": "EcsTaskSecurityGroup" }]
          }
        },
        "LoadBalancers": [{ "ContainerName": "workspace", "ContainerPort": 3000, "TargetGroupArn": { "Ref": "WorkspaceTargetGroup" } }],
        "HealthCheckGracePeriodSeconds": 120
      }
    },

    "FacebookLeadCronRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "HasCronSecret",
      "Properties": {
        "RoleName": { "Fn::Sub": "htc-${EnvironmentName}-facebook-lead-cron" },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [{ "Effect": "Allow", "Principal": { "Service": "events.amazonaws.com" }, "Action": "sts:AssumeRole" }]
        },
        "Policies": [{
          "PolicyName": "InvokeFacebookLeadApiDestinations",
          "PolicyDocument": {
            "Version": "2012-10-17",
            "Statement": [{
              "Effect": "Allow",
              "Action": "events:InvokeApiDestination",
              "Resource": "*"
            }]
          }
        }]
      }
    },
    "FacebookLeadCronConnection": {
      "Type": "AWS::Events::Connection",
      "Condition": "HasCronSecret",
      "Properties": {
        "Name": { "Fn::Sub": "htc-${EnvironmentName}-facebook-lead-cron" },
        "AuthorizationType": "API_KEY",
        "AuthParameters": {
          "ApiKeyAuthParameters": {
            "ApiKeyName": "Authorization",
            "ApiKeyValue": { "Fn::Sub": "Bearer ${CronSecret}" }
          }
        }
      }
    },
    "FacebookLeadSyncApiDestination": {
      "Type": "AWS::Events::ApiDestination",
      "Condition": "HasCronSecret",
      "Properties": {
        "Name": { "Fn::Sub": "htc-${EnvironmentName}-facebook-lead-sync" },
        "ConnectionArn": { "Fn::GetAtt": ["FacebookLeadCronConnection", "Arn"] },
        "InvocationEndpoint": { "Fn::Sub": "https://${VenueAppHostname}/api/facebook/sync/process" },
        "HttpMethod": "GET",
        "InvocationRateLimitPerSecond": 10
      }
    },
    "FacebookLeadReconcileApiDestination": {
      "Type": "AWS::Events::ApiDestination",
      "Condition": "HasCronSecret",
      "Properties": {
        "Name": { "Fn::Sub": "htc-${EnvironmentName}-facebook-lead-reconcile" },
        "ConnectionArn": { "Fn::GetAtt": ["FacebookLeadCronConnection", "Arn"] },
        "InvocationEndpoint": { "Fn::Sub": "https://${VenueAppHostname}/api/facebook/reconcile/process" },
        "HttpMethod": "GET",
        "InvocationRateLimitPerSecond": 1
      }
    },
    "FacebookLeadSyncRule": {
      "Type": "AWS::Events::Rule",
      "Condition": "HasCronSecret",
      "DependsOn": ["VenueAppService"],
      "Properties": {
        "Name": { "Fn::Sub": "htc-${EnvironmentName}-facebook-lead-sync" },
        "Description": "Process facebook_lead_queue every 2 minutes (Lead Ads webhook after() is the fast path; this is the retry/crash backstop).",
        "ScheduleExpression": "rate(2 minutes)",
        "State": "ENABLED",
        "Targets": [{
          "Id": "FacebookLeadSync",
          "Arn": { "Fn::GetAtt": ["FacebookLeadSyncApiDestination", "Arn"] },
          "RoleArn": { "Fn::GetAtt": ["FacebookLeadCronRole", "Arn"] }
        }]
      }
    },
    "FacebookLeadReconcileRule": {
      "Type": "AWS::Events::Rule",
      "Condition": "HasCronSecret",
      "DependsOn": ["VenueAppService"],
      "Properties": {
        "Name": { "Fn::Sub": "htc-${EnvironmentName}-facebook-lead-reconcile" },
        "Description": "Hourly Meta Lead Ads reconciliation poll for missed webhook deliveries.",
        "ScheduleExpression": "rate(1 hour)",
        "State": "ENABLED",
        "Targets": [{
          "Id": "FacebookLeadReconcile",
          "Arn": { "Fn::GetAtt": ["FacebookLeadReconcileApiDestination", "Arn"] },
          "RoleArn": { "Fn::GetAtt": ["FacebookLeadCronRole", "Arn"] }
        }]
      }
    }
  },

  "Outputs": {
    "AlbDnsName": { "Value": { "Fn::GetAtt": ["Alb", "DNSName"] }, "Description": "Use with curl -H \"Host: <app hostname>\" for pre-DNS smoke testing" },
    "EcsClusterName": { "Value": { "Ref": "EcsCluster" } }
  }
}
