import { createRequire } from "node:module";
import { readFileSync, writeFileSync } from "node:fs";
import { config } from "dotenv";
config({ path: ".env.local", quiet: true });
const require = createRequire("/Users/jensmac/Developer/wevenu-website/marketing/package.json");
const { chromium } = require("playwright");
const creds = JSON.parse(readFileSync("/tmp/htc-byb-phase-b-creds.json", "utf8"));
const OUT = `${process.env.HOME}/Desktop/HTC-Phase-B-Browser-Acceptance`;
const browser = await chromium.launch({ headless: true });
const page = await (await browser.newContext({ viewport: { width: 1440, height: 1100 } })).newPage();
await page.goto("http://localhost:3040/login", { waitUntil: "domcontentloaded" });
await page.locator("#email").fill(creds.email);
await page.locator("#password").fill(creds.password);
await page.getByRole("button", { name: "Sign in" }).click();
await page.waitForURL((u: URL) => !u.pathname.includes("/login"), { timeout: 20000, waitUntil: "commit" });
await page.goto("http://localhost:3040/setup-hub", { waitUntil: "commit" }).catch(() => {});
await page.waitForLoadState("domcontentloaded");
await page.getByText("Bring your business over").waitFor({ timeout: 20000 });
writeFileSync(`${OUT}/28-setup-hub-after-imports.png`, await page.screenshot({ fullPage: true }));
const text = await page.locator("main").innerText();
console.log(text.split("Bring your business over")[1]?.slice(0, 500) ?? text.slice(0, 500));
await browser.close();
