{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@shared/relationships": [
        "../shared/relationships/index.ts"
      ],
      "@shared/relationships/*": [
        "../shared/relationships/*"
      ],
      "@shared/email": [
        "../shared/email/index.ts"
      ],
      "@shared/email/*": [
        "../shared/email/*"
      ],
      "@shared/product-sync": [
        "../shared/product-sync/index.ts"
      ],
      "@shared/product-sync/*": [
        "../shared/product-sync/*"
      ],
      "@shared/product-account": [
        "../shared/product-account/index.ts"
      ],
      "@shared/product-account/*": [
        "../shared/product-account/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
