# Hello to Cheers Marketing — local environment
#
# Copy to .env.local and fill values from the Stripe Dashboard.

NEXT_PUBLIC_MARKETING_URL=http://localhost:3001

# Stripe (SaaS billing — Hello to Cheers account, Test mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Gather $149/month — canonical Price (preferred names, then legacy starter)
STRIPE_GATHER_PRICE_ID=price_...
# GATHER_PRICE_ID=price_...
# STRIPE_PRICE_STARTER=price_...

# Founding Member: $30/mo coupon on Gather → $119 (NOT a separate $119 Price)
# Applied server-side while FOUNDER_PROGRAM_ACTIVE + spots remain.
STRIPE_FOUNDING_COUPON_ID=coupon_...
# FOUNDING_MEMBER_COUPON_ID=coupon_...

# Recurring Price IDs — Celebrate / Flourish (+ Gather legacy alias)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWING=price_...
STRIPE_PRICE_PROFESSIONAL=price_...

# Founder Price IDs — Celebrate / Flourish while program active.
# Gather prefers STRIPE_FOUNDING_COUPON_ID; STARTER_FOUNDER is legacy fallback only.
STRIPE_PRICE_STARTER_FOUNDER=price_...
STRIPE_PRICE_GROWING_FOUNDER=price_...
STRIPE_PRICE_PROFESSIONAL_FOUNDER=price_...

# Optional one-time White Glove onboarding add-on (same Checkout Session as the subscription).
# Required only when a customer selects White Glove Setup at pre-checkout.
STRIPE_PRICE_WHITE_GLOVE=price_...

# Enrollment programs (Pricing display + automatic Founding Member at checkout)
# Every new subscription gets Founding pricing while active and spots remain.
# No pre-purchase approval. Welcome Back is requested at pre-checkout; verified later in CRM.
FOUNDER_PROGRAM_ACTIVE=true
# Total founder seats (workspace + marketing capacity). Remaining = capacity − live founding count.
FOUNDER_PROGRAM_CAPACITY=100
# Fallback remaining when the live relationship store is empty (ignored when live founders exist).
FOUNDER_SPOTS_REMAINING=100

# Stripe Payment Links — optional / ops (public checkout uses Checkout Sessions)
STRIPE_PAYMENT_LINK_GATHER_FOUNDER=
STRIPE_PAYMENT_LINK_CELEBRATE_FOUNDER=
STRIPE_PAYMENT_LINK_FLOURISH_FOUNDER=

# Stripe Payment Links — Welcome Back (legacy; not used as a pre-purchase gate)
STRIPE_PAYMENT_LINK_GATHER_WELCOME_BACK=
STRIPE_PAYMENT_LINK_CELEBRATE_WELCOME_BACK=
STRIPE_PAYMENT_LINK_FLOURISH_WELCOME_BACK=

# Stripe Payment Links — Standard
STRIPE_PAYMENT_LINK_GATHER_STANDARD=
STRIPE_PAYMENT_LINK_CELEBRATE_STANDARD=
STRIPE_PAYMENT_LINK_FLOURISH_STANDARD=

# Inquiry + subscription notifications (Contact / Walkthrough / Welcome Back / new enrollments)
# Product welcome emails use the same Resend client via @shared/email (see shared/email/README.md).
# Without RESEND_API_KEY, product emails dry-run to console and still append timeline email_sent.
RESEND_API_KEY=
EMAIL_FROM=Hello to Cheers <hello@hellotocheers.com>
EMAIL_REPLY_TO=hello@hellotocheers.com
# Back-compat alias for EMAIL_FROM (ops notify + older docs)
# FROM_EMAIL=Hello to Cheers <hello@hellotocheers.com>
INQUIRY_NOTIFY_EMAIL=hello@hellotocheers.com

# Product app hard-lock on Suspend / invoice.paid reactivate
# PRODUCT_API_BASE_URL=http://localhost:3000
# PRODUCT_SYNC_API_KEY=dev-product-sync-key

# Shared Relationship Workspace store (default: ../shared/relationships/.data from marketing/)
# RELATIONSHIPS_DATA_PATH=

# Calendly — Schedule a Walkthrough (/walkthrough)
# Jennifer: copy these into marketing/.env.local, then RESTART the marketing
# app (NEXT_PUBLIC_* is baked in at startup — saving .env alone is not enough).
# Without NEXT_PUBLIC_CALENDLY_URL the page shows “Scheduling link coming soon”
# and the email form still creates status walkthrough_requested (no Calendly required).
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/YOUR-LINK/walkthrough
#
# Webhook (Calendly Developer → Webhooks):
#   URL:    https://<your-marketing-host>/api/calendly/webhook
#   Events: invitee.created, invitee.canceled
# Signing key is returned once when you create the subscription — store it here.
CALENDLY_WEBHOOK_SIGNING_KEY=
# Optional fallback when signing key is unset: require header
#   x-calendly-webhook-secret: <value>
# CALENDLY_WEBHOOK_SHARED_SECRET=
