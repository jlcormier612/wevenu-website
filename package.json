{
  "name": "wevenu-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:marketing": "npm run dev --prefix marketing",
    "dev:marketing:detach": "bash scripts/start-marketing-dev.sh",
    "dev:workspace": "npm run dev --prefix workspace",
    "dev:workspace:detach": "bash scripts/start-workspace-dev.sh",
    "dev:venue:detach": "bash scripts/start-venue-dev.sh",
    "dev:all:detach": "bash scripts/start-all-dev.sh",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint",
    "postinstall": "patch-package",
    "test": "tsx --test lib/**/*.test.ts lib/legal/**/*.test.ts lib/venue-guide/**/*.test.ts components/welcome-experience/**/*.test.ts workspace/lib/legal/**/*.test.ts",
    "test:watch": "tsx --test --watch lib/**/*.test.ts lib/legal/**/*.test.ts lib/venue-guide/**/*.test.ts components/welcome-experience/**/*.test.ts workspace/lib/legal/**/*.test.ts",
    "process:lifecycle": "node scripts/process-lifecycle.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@base-ui/react": "^1.6.0",
    "@react-pdf/renderer": "^4.6.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.21.0",
    "mammoth": "^1.12.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.4",
    "pdf-parse": "^2.4.5",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5"
  }
}
